{
  "name": "dashed-astro",
  "version": "3.23.1",
  "type": "module",
  "scripts": {
    "db:push": "drizzle-kit push:sqlite",
    "db:studio": "drizzle-kit studio",
    "db:generate": "bunx drizzle-kit generate --dialect sqlite --schema ./src/lib/db/schema.ts",
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "compile": "bun build ./dist/server/entry.mjs --compile --bytecode --outfile dashed",
    "preview": "bun ./dist/server/entry.mjs",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check": "bun run format && bun run lint:fix && astro check"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.2",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^6.0.0",
    "@lucide/astro": "^1.47.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "7.4.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1"
  }
}
